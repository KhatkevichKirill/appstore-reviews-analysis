      "name": "Collapse IDs"
    },
    {
      "parameters": {
        "jsCode": "const existing = new Set($('Collapse IDs').first().json.existingIds.map(String));\n\nreturn $input\n  .all()\n  .filter((item) => {\n    const id = item.json.id;\n    if (id === undefined || id === null) return false;\n    return !existing.has(String(id));\n  })\n  .map((item) => ({ json: item.json }));"
      },
